# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored so your local settings never get committed.

# --- Database (used by both the TypeScript app and the Python ETL) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ship_db"

# --- ETL input data ---
# Absolute path to the directory where you keep the source spreadsheets / CSVs
# that the etl/*.py scripts import (e.g. "IBC Code Chemical.xlsx",
# "Cargo Library 3 TABLE OF CHEMICAL CARGO.xlsx", ...).
# If unset, scripts fall back to etl/data/inputs/.
# Override the file for a single run with:  python3 etl/<script>.py --file /path/to/file.xlsx
SHIP_DATA_DIR="/absolute/path/to/your/ship_documents"

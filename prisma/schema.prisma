// Severity of a procedure-level instruction (procedure_template_instruction).
enum InstructionType {
  DANGER // fire, explosion, violent reaction, tank damage, serious injury
  WARNING // precaution required to perform the procedure safely
  CAUTION // prevents equipment damage or operational problems
  IMPORTANT // mandatory operational information, not a safety hazard
  INFO // describes the cargo or explains why something is done
}

enum CleaningStepType {
  PRECONDITION // a state the tank must already be in (e.g. "Well Drained")
  PRECLEANING
  CLEANING
  RINSING
  FLUSHING
  STEAMING
  DRAINING
  DRYING
  VENTILATING
  PURGING
  GAS_FREEING
  MOPPING
}

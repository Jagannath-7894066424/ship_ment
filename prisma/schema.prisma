generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model source {
  id                 Int            @id @unique @default(autoincrement())
  name               String
  edition            String?
  publisher          String?
  file_path          String?
  rank_regulatory    Int?
  rank_cleaning      Int?
  rank_compatibility Int?
  rank_physical      Int?
  rank_health        Int?
  date_published     DateTime?      @default(now())
  date_ingested      DateTime       @default(now())
  source_type        String?
  notes              String?
  category           SourceCategory @default(chemical)
  created_at         DateTime?      @default(now())
  updated_at         DateTime       @default(now())

  cargo_chemicals     cargo_chemical[]
  cargoPropertyValues cargo_property_values[]

  cargoSynonyms cargo_synonym[]

  reactiveGroups reactive_groups[]

  cargoReactiveGroups cargo_reactive_group[]

  compatibilities compatibility[]

  compatibilityExceptions compatibility_exception[]

  cleanlinessStandards cleanliness_standards[]

  cargoRequiredCleanlinesses cargo_required_cleanliness[]

  procedureTemplates procedure_templates[]

  marineChemicals marine_chemicals[]

  changelogs changelog[]

  operationalRequirements operational_requirement[]

  // New source-scoped children (replace cleaning_procedures + coatings)
  cleaningProcesses cleaning_process[]
  cargoCoatings     cargo_coating[]

  cargoHazardDatas cargo_hazard_data[]

  cargoDotHazmats cargo_dot_hazad[]

  cargoUnNumbers cargo_un_number[]

  cargoFamilyGroups cargo_family_group[]

  // Crude-oil branch. Independent of the cargo_chemical branch above; the two
  // meet only here, at source.
  crudeOils              crude_oil[]
  crudeOilPropertyValues crude_oil_property_values[]

  // Gas branch. Same rule as crude oil: its own master + its own property
  // table, no FK to either of the other two masters.
  gases             gas[]
  gasPropertyValues gas_property_values[]

  crudeOilSynonyms crude_oil_synonym[]
}

/// What class of material a source describes. `gas` is defined for future gas
/// sources; no gas source exists yet.
enum SourceCategory {
  chemical
  oil
  gas
}

/// Which master table an operational row is about.
///
/// Used ONLY by the common operational tables (procedure_templates,
/// cleaning_process). It is the discriminator that says which of the three
/// master tables cleaning_process.cargo_id / from_cargo_id / to_cargo_id point
/// at, because one FK column cannot target three tables. Master tables never
/// carry this column - they ARE the type.
///
/// Deliberately separate from SourceCategory: that describes a document, this
/// describes a row of operational data. A single source could in principle
/// publish procedures for more than one cargo type.
enum CargoType {
  CHEMICAL // -> cargo_chemical
  OIL // -> crude_oil
  GAS // -> gas
}

/// Crude oil master record.
///
/// Deliberately NOT related to cargo_chemical: a crude oil is its own entity,
/// not a subtype of a chemical cargo. API / sulfur / pour point and every other
/// measured quantity live in crude_oil_property_values, never as columns here.
model crude_oil {
  id                Int      @id @unique @default(autoincrement())
  oil_name          String
  source_id         Int
  country_of_origin String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  properties crude_oil_property_values[]
  synonyms   crude_oil_synonym[]

  source source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  // Identity is per-source. The same crude appears in multiple sources with
  // different assay values and each must keep its own row; a global unique on
  // oil_name would collapse them.
  @@unique([oil_name, source_id])
  @@index([oil_name])
  @@index([source_id])
}

/// Source-aware property values for crude oils.
///
/// Same shape as cargo_property_values, plus normalized_min / normalized_max
/// because the assay source quotes most properties as Min/Max ranges.
model crude_oil_property_values {
  id           Int    @id @unique @default(autoincrement())
  crude_oil_id Int
  source_id    Int
  field_name   String

  value            String? // raw value exactly as the source records it
  normalized_value Float? // numeric form for a single-point value
  normalized_min   Float? // lower bound when the source quotes a range
  normalized_max   Float? // upper bound when the source quotes a range
  unit             String? // unit as published (°F here, °C there - never assume)
  value_type       String? // number | text | boolean | range | enum

  source_synonym_id Int?
  source_page_ref   String?
  as_of_date        DateTime?
  entered_date      DateTime
  entered_by        String
  entry_type        String
  is_winning        Boolean
  conflict_flag     Boolean
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  synonym          synonyms?         @relation(fields: [source_synonym_id], references: [id], onDelete: SetNull)
  field_definition field_definitions @relation(fields: [field_name], references: [field_name], onDelete: Cascade)
  crude_oil        crude_oil         @relation(fields: [crude_oil_id], references: [id], onDelete: Cascade)
  source           source            @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([crude_oil_id, source_id, field_name])
  @@index([crude_oil_id])
  @@index([source_id])
  @@index([field_name])
  @@index([crude_oil_id, source_id])
  @@index([crude_oil_id, field_name])
}

/// Gas cargo master record.
///
/// Third master entity, a sibling of cargo_chemical and crude_oil - NOT a
/// subtype of either. Shaped on crude_oil because the two share the same
/// pattern (a named product, sourced, with all measured quantities pushed into
/// a property-value table) rather than because a gas is a kind of oil.
///
/// No gas source has been loaded yet; the table exists so cleaning_process and
/// procedure_templates have a real GAS master to point at. Columns are limited
/// to what identity requires - do NOT add assay columns here, they belong in
/// gas_property_values.
model gas {
  id                Int      @id @unique @default(autoincrement())
  gas_name          String
  source_id         Int
  country_of_origin String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  properties gas_property_values[]

  source source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  // Per-source identity, same reasoning as crude_oil: two sources describing
  // the same gas keep their own rows and their own values.
  @@unique([gas_name, source_id])
  @@index([gas_name])
  @@index([source_id])
}

/// Source-aware property values for gases.
///
/// Mirrors crude_oil_property_values exactly, min/max included: gas
/// specifications are quoted as ranges at least as often as crude assays are.
model gas_property_values {
  id         Int    @id @unique @default(autoincrement())
  gas_id     Int
  source_id  Int
  field_name String

  value            String? // raw value exactly as the source records it
  normalized_value Float? // numeric form for a single-point value
  normalized_min   Float? // lower bound when the source quotes a range
  normalized_max   Float? // upper bound when the source quotes a range
  unit             String? // unit as published
  value_type       String? // number | text | boolean | range | enum

  source_synonym_id Int?
  source_page_ref   String?
  as_of_date        DateTime?
  entered_date      DateTime
  entered_by        String
  entry_type        String
  is_winning        Boolean
  conflict_flag     Boolean
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  synonym          synonyms?         @relation(fields: [source_synonym_id], references: [id], onDelete: SetNull)
  field_definition field_definitions @relation(fields: [field_name], references: [field_name], onDelete: Cascade)
  gas              gas               @relation(fields: [gas_id], references: [id], onDelete: Cascade)
  source           source            @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([gas_id, source_id, field_name])
  @@index([gas_id])
  @@index([source_id])
  @@index([field_name])
  @@index([gas_id, source_id])
  @@index([gas_id, field_name])
}

model cargo_family_group {
  id          Int      @id @default(autoincrement())
  source_id   Int
  family_code String // the guide's own number, e.g. "10"
  family_name String // printed heading, or the sole member's name
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  source source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  cargoChemicals        cargo_chemical[]
  cleaningProcessesFrom cleaning_process[] @relation("cp_from_family")
  cleaningProcessesTo   cleaning_process[] @relation("cp_to_family")

  // Verwey 10, Drew index 10 and Miracle entry 10 are unrelated.
  @@unique([source_id, family_code])
  @@index([source_id])
  @@index([family_name])
}

model field_definitions {
  id             Int      @id @default(autoincrement())
  field_name     String   @unique
  display_name   String
  data_type      String
  unit           String?
  category       String
  enum_values    Json?
  typical_source String?
  description    String?
  display_order  Int?
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  cargoPropertyValues    cargo_property_values[]
  crudeOilPropertyValues crude_oil_property_values[]
  gasPropertyValues      gas_property_values[]
}

model cargo_chemical {
  id                     Int     @id @unique @default(autoincrement())
  canonical_name         String
  source_id              Int?
  cas_number             String?
  ibc_chapter            String?
  ibc_product_name       String?
  ibc_pollution_category String?

  hazards                                String?
  ship_type                              Int?
  tank_type                              String?
  tank_vents                             String?
  tank_environment_control               String?
  electrical_equipment_temperature_class electrical_equipment_temperature_class?

  electrical_equipment_apparatus_group electrical_equipment_apparatus_group? // IIA,IIB,IIC
  flashpoint_requirement               String? //Flash Point  requirement Yes/No, 
  gauging                              gauging?
  vapour_detection                     String?
  fire_protection                      String?
  emergency_equipment                  Boolean?

  marpol_category String?

  molecular_weight_g_mol Float?
  boiling_point_c        Float?
  melting_point_c        Float?
  density_g_cm3          Float? // Density,SpGr
  vapor_pressure_kpa_20c Float?
  viscosity_cp_20c       Float?
  flash_point_c          Float? // Flash point
  correction_factor      Float?

  water_solubility String?
  water_reactive   Boolean?

  stowage_notes           String?
  reference_temperature_c Float?
  lel                     Float?
  uel                     Float?
  colour                  String?

  uscg_compatibility_group String?

  // Identity / descriptive fields (ChemServe + SDS profiles)
  molecular_formula   String?
  appearance          String?
  product_description String?

  // Heating requirements. Each source cell is "N" (not required), "Y" (required,
  // no temperature) or a number (required, with the minimum/maximum temperature
  // in °C). Stored as a boolean flag + an optional temperature per stage.
  heat_adjacent_required        Boolean?
  heat_adjacent_temperature     Decimal? @db.Decimal(5, 2)
  heating_required_voyage       Boolean?
  heating_voyage_temperature    Decimal? @db.Decimal(5, 2)
  heating_required_discharge    Boolean?
  heating_discharge_temperature Decimal? @db.Decimal(5, 2)

  compliance        String?
  date_added        DateTime @default(now())
  date_last_updated DateTime @default(now())
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  source source? @relation(fields: [source_id], references: [id], onDelete: Cascade)

  cargoPropertyValues cargo_property_values[]

  cargoSynonyms cargo_synonym[]

  cargoReactiveGroups       cargo_reactive_group[]
  compatibilityExceptions_a compatibility_exception[] @relation("cargo_a_id")
  compatibilityExceptions_b compatibility_exception[] @relation("cargo_b_id")

  cargoRequiredCleanlinesses cargo_required_cleanliness[]

  // NOTE: cleaning_process no longer relates to cargo_chemical by FK - its
  // cargo columns are polymorphic (see cleaning_process). Query them with
  // cargo_type: CHEMICAL + the cargo id; see src/cargo-type.ts.

  cargoCoatings cargo_coating[]

  marineChemicalUses marine_chemical_use[] @relation("target_cargo")

  cargoOperationalRequirements cargo_operational_requirement[]

  cargoUnNumbers   cargo_un_number[]
  cargoHazardDatas cargo_hazard_data[]

  // The cleaning family this cargo belongs to, for guides that group cargoes
  // (Verwey). NULL for sources that publish no grouping.
  cargo_family_group_id Int?
  cargoFamilyGroup      cargo_family_group? @relation(fields: [cargo_family_group_id], references: [id], onDelete: SetNull)
  cargoDotHazmats       cargo_dot_hazad[]

  @@unique([source_id, canonical_name]) // one row per chemical per source (dedup key)
  @@index([canonical_name])
  @@index([cas_number])
  @@index([source_id])
}

// UN transport numbers for a chemical. A chemical can have several UN numbers,
// each optionally qualified (e.g. by concentration or physical state), so they
// live in their own table rather than a single cargo_chemical column.
model cargo_un_number {
  id              Int      @id @default(autoincrement())
  cargo_id        Int
  source_id       Int? // which reference the UN number was read from
  un_number       String
  qualifier_type  String? // e.g. "concentration", "physical_state"
  qualifier_value String? // e.g. "10-80%", ">80% (Glacial)", "Compressed"
  remarks         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  cargo_chemical cargo_chemical @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  source         source?        @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@index([cargo_id])
  @@index([un_number])
  @@index([source_id])
}

model cargo_property_values {
  id                Int       @id @unique @default(autoincrement())
  cargo_id          Int
  source_id         Int
  field_name        String
  value             String? // raw value as recorded by the source
  normalized_value  Float? // numeric form for range/compare queries (nullable for text props)
  unit              String? // unit the value is expressed in (e.g. kPa, cP, °C)
  value_type        String? // number | text | boolean | range | enum
  source_synonym_id Int?
  source_page_ref   String?
  as_of_date        DateTime?
  entered_date      DateTime
  entered_by        String
  entry_type        String
  is_winning        Boolean
  conflict_flag     Boolean
  notes             String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now())

  synonym          synonyms?         @relation(fields: [source_synonym_id], references: [id], onDelete: SetNull)
  field_definition field_definitions @relation(fields: [field_name], references: [field_name], onDelete: Cascade)
  cargo_chemical   cargo_chemical    @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  source           source            @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([cargo_id, source_id, field_name]) // one value per field per source
  @@index([cargo_id])
  @@index([source_id])
  @@index([field_name])
  @@index([cargo_id, source_id])
  @@index([cargo_id, field_name])
}

model synonyms {
  id              Int      @id @unique @default(autoincrement())
  synonym_text    String
  normalized_text String
  language        String?
  date_added      DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  cargoPropertyValues    cargo_property_values[]
  crudeOilPropertyValues crude_oil_property_values[]
  gasPropertyValues      gas_property_values[]

  cargoSynonyms    cargo_synonym[]
  crudeOilSynonyms crude_oil_synonym[]
}

/// Alternative names for a crude oil / refined product, mirroring cargo_synonym.
///
/// The synonyms table itself is owner-agnostic, so it needs a link table per
/// master. Without this one a grade name could be stored but never reached from
/// the oil it names.
model crude_oil_synonym {
  id           Int @id @default(autoincrement())
  crude_oil_id Int
  synonym_id   Int

  /// Where the name came from in the source: "grade_name" for the Shell Cargo
  /// Master "Grade Names" column, leaving room for trade names and abbreviations.
  relationship_type    String
  /// True when this text names more than one product within the same source -
  /// "V-Power Diesel" is listed against both ULSD grades AND is a product in its
  /// own right, so a lookup on it cannot resolve to a single oil.
  ambiguity_flag       Boolean  @default(false)
  source_id            Int?
  preferred_for_search Boolean?
  notes                String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  crude_oil crude_oil @relation(fields: [crude_oil_id], references: [id], onDelete: Cascade)
  synonyms  synonyms  @relation(fields: [synonym_id], references: [id], onDelete: Cascade)
  source    source?   @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([crude_oil_id, synonym_id]) // link an oil to a name at most once
  @@index([crude_oil_id])
  @@index([synonym_id])
  @@index([source_id])
}

model cargo_synonym {
  id                   Int      @id @unique @default(autoincrement())
  cargo_id             Int
  synonym_id           Int
  relationship_type    String
  ambiguity_flag       Boolean
  source_id            Int?
  preferred_for_search Boolean?
  notes                String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  cargo_chemical cargo_chemical @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  synonyms       synonyms       @relation(fields: [synonym_id], references: [id], onDelete: Cascade)
  source         source?        @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([cargo_id, synonym_id]) // link a chemical to a synonym at most once
}

model reactive_groups {
  id          Int               @id @unique @default(autoincrement())
  system      String
  group_code  String            @unique
  group_name  String
  group_type  ReactiveGroupType // groups 1–22 = REACTIVE, 30–43 = CARGO
  description String?
  source_id   Int
  created_at  DateTime          @default(now())
  updated_at  DateTime          @default(now())
  source      source            @relation(fields: [source_id], references: [id], onDelete: Cascade)

  cargoReactiveGroups cargo_reactive_group[]

  compatibilities_a compatibility[] @relation("group_a_id")
  compatibilities_b compatibility[] @relation("group_b_id")

  // compatibilities compatibility[] @relation("group_b_id")

  compatibilityExceptions_a compatibility_exception[] @relation("group_a_id")

  compatibilityExceptions_b compatibility_exception[] @relation("group_b_id")

  masterCargoChemicalGroupDetails master_cargo_chemical_group_details[]
}

model master_cargo_chemical_group_details {
  id         Int      @id @unique @default(autoincrement())
  group_code String
  group_name String
  cargo_name String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  group reactive_groups @relation(fields: [group_code], references: [group_code], onDelete: Cascade)
}

model cargo_reactive_group {
  id                Int             @id @unique @default(autoincrement())
  cargo_id          Int
  reactive_group_id Int
  group_code        Int
  isPrimary         Boolean         @default(false)
  source_id         Int
  notes             String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @default(now())
  cargo_chemical    cargo_chemical  @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  reactive_groups   reactive_groups @relation(fields: [reactive_group_id], references: [id], onDelete: Cascade)
  source            source          @relation(fields: [source_id], references: [id], onDelete: Cascade)
}

model compatibility {
  id                   Int     @id @unique @default(autoincrement())
  group_a_id           Int
  group_b_id           Int
  compatible           Boolean // X in the chart => false, blank => true
  severity             String?
  reaction_description String?
  source_id            Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  reactive_group_a reactive_groups @relation("group_a_id", fields: [group_a_id], references: [id], onDelete: Cascade)
  reactive_group_b reactive_groups @relation("group_b_id", fields: [group_b_id], references: [id], onDelete: Cascade)
  source           source          @relation(fields: [source_id], references: [id], onDelete: Cascade)

  // Symmetric pair stored once, in canonical order group_a_id <= group_b_id.
  @@unique([group_a_id, group_b_id])
}

// Official chemical-pair exceptions from Appendix I of 46 CFR Part 150.
// An exception ALWAYS overrides the reactive-group compatibility matrix.
model compatibility_exception {
  id             Int                        @id @unique @default(autoincrement())
  cargo_a_id     Int
  cargo_b_id     Int?
  group_a_id     Int?
  group_b_id     Int?
  compatible     Boolean // the Appendix outcome for this specific chemical pair
  exception_type CompatibilityExceptionType
  appendix       String? // e.g. "I"
  section        String? // e.g. "I(a)" / "I(b)"
  reason         String?
  notes          String?
  source_id      Int
  created_at     DateTime                   @default(now())
  updated_at     DateTime                   @default(now())

  cargo_a cargo_chemical   @relation("cargo_a_id", fields: [cargo_a_id], references: [id], onDelete: Cascade)
  cargo_b cargo_chemical?  @relation("cargo_b_id", fields: [cargo_b_id], references: [id], onDelete: Cascade)
  group_a reactive_groups? @relation("group_a_id", fields: [group_a_id], references: [id], onDelete: Cascade)
  group_b reactive_groups? @relation("group_b_id", fields: [group_b_id], references: [id], onDelete: Cascade)
  source  source           @relation(fields: [source_id], references: [id], onDelete: Cascade)

  // One exception per chemical pair, stored in canonical order cargo_a_id <= cargo_b_id.
  @@unique([cargo_a_id, cargo_b_id])
  @@index([cargo_a_id])
  @@index([cargo_b_id])
}

model cleanliness_standards {
  id          Int      @id @unique @default(autoincrement())
  code        String
  name        String
  description String?
  test_method String?
  source_id   Int
  notes       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  source      source   @relation(fields: [source_id], references: [id], onDelete: Cascade)

  cargoRequiredCleanlinesses cargo_required_cleanliness[]
}

model cargo_required_cleanliness {
  id                       Int                   @id @unique @default(autoincrement())
  cargo_id                 Int
  cleanliness_standards_id Int
  mandatory                Boolean
  source_id                Int
  notes                    String?
  created_at               DateTime              @default(now())
  updated_at               DateTime              @default(now())
  cargo_chemical           cargo_chemical        @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  cleanliness_standards    cleanliness_standards @relation(fields: [cleanliness_standards_id], references: [id], onDelete: Cascade)
  source                   source                @relation(fields: [source_id], references: [id], onDelete: Cascade)
}

/// COMMON reusable procedure definition, shared by all three cargo types.
///
/// Answers "what does this code mean?" - CW = Cold Water Wash. There is
/// deliberately ONE table, not one per cargo type; cargo_type says which master
/// the procedure is written for.
model procedure_templates {
  id                     Int       @id @default(autoincrement())
  procedure_code         String
  template_name          String
  /// Which cargo master this procedure is written for. Every row that existed
  /// before this column was added is a chemical tank-cleaning procedure
  /// (Verwey, Drew Ameroid), which is what the default backfills.
  cargo_type             CargoType @default(CHEMICAL)
  description            String?
  target_purpose         String?
  water_type             String?
  default_temperature_c  Int?
  default_duration_hours Int?
  default_chemicals      Json?
  ventilation_required   Boolean?
  gas_free_required      Boolean?
  wall_wash_required     Boolean?
  inert_gas_required     Boolean?
  source_id              Int
  /// Page / section of the source document this definition was read from
  /// (e.g. "2" for the Shell matrix legend page). Kept per row because one
  /// source can define its procedures across several pages.
  source_page_ref        String?
  /// The procedure exactly as the source document words it, kept alongside the
  /// structured steps/requirements rather than instead of them. Normalisation
  /// is lossy by nature; this is what makes the loss auditable and lets the
  /// rows be re-derived if the parsing rules change.
  source_definition      String?   @db.Text
  /// False only for decision codes that forbid the transition outright (NC).
  /// A cleaning_process pointing at such a template means "do not load", and
  /// its step list is legitimately empty.
  loading_allowed        Boolean?  @default(true)
  notes                  String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  source source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  procedureTemplateSteps        procedure_template_steps[]
  procedureTemplateInstructions procedure_template_instruction[]
  procedureTemplateRequirements procedure_template_requirement[]
  marineChemicalUses            marine_chemical_use[]
  cleaningProcesses             cleaning_process[]

  // A code is unique within its source, not globally: Verwey "A" and Shell "CW"
  // live in the same table and must not be forced to agree.
  @@unique([source_id, procedure_code])
  @@index([cargo_type])
  @@index([source_id])
  @@index([procedure_code])
  @@index([cargo_type, source_id])
}

// Procedure-LEVEL instructions: statements that apply to the whole procedure
// rather than to one numbered step — the "NOTE :" blocks that follow (or, more
// rarely, precede) the steps in the Verwey and Drew Ameroid guides. Kept apart
// from procedure_template_steps because they have no position in the step
// sequence and are classified by severity instead.
model procedure_template_instruction {
  id                     Int             @id @default(autoincrement())
  procedure_templates_id Int
  instruction_type       InstructionType
  message                String          @db.Text
  display_order          Int // order the instructions are shown in, 1-based
  mandatory              Boolean         @default(true) // false for advisory wording ("is advisable")
  notes                  String?
  created_at             DateTime        @default(now())
  updated_at             DateTime        @default(now())

  procedure_templates procedure_templates @relation(fields: [procedure_templates_id], references: [id], onDelete: Cascade)

  @@unique([procedure_templates_id, display_order]) // one instruction per slot; lets a re-extract upsert in place
  @@index([procedure_templates_id])
  @@index([instruction_type])
}

/// Ordered physical actions of a procedure: what is done, in what order.
///
/// Distinct from procedure_template_requirement, which carries the rules and
/// limits that constrain those actions but occupy no position in the sequence.
model procedure_template_steps {
  id                     Int                 @id @unique @default(autoincrement())
  procedure_templates_id Int
  step_order             Int
  step_name              String
  /// What kind of operation this step is, so a reader can act on the step
  /// without parsing step_name. NULL for rows loaded before the column existed.
  step_type              CleaningStepType?
  step_description       String?
  // Free-text values as published in the guide (e.g. "About 2½ hours", "80°C",
  // "Cold", "Teepol 0.05%") — not always numeric, so stored as text.
  medium                 String? // e.g. Sea Water, Fresh Water, Steam, Toluene, Methanol, Dry Gas Oil, Nitrogen
  temperature            String? // e.g. "Cold", "80°C", "Warm (50°C)"
  duration               String? // e.g. "1 hour", "About 2½ hours", "Until odour disappears"
  cleaner                String? // e.g. "Teepol 0.05%", "0.05% liquid detergent"
  mandatory              Boolean
  notes                  String?
  created_at             DateTime            @default(now())
  updated_at             DateTime            @default(now())
  procedure_templates    procedure_templates @relation(fields: [procedure_templates_id], references: [id], onDelete: Cascade)

  // One step per slot, so a re-import upserts in place instead of appending a
  // second copy of the whole procedure.
  @@unique([procedure_templates_id, step_order])
  @@index([procedure_templates_id])
  @@index([step_type])
}

/// Rules, limits and conditions that constrain a procedure but are not steps.
///
/// Three things live here that steps cannot express:
///   - measured limits    ROB_LIMIT <= 0.05 %
///   - preconditions      PRECONDITION = WD
///   - disjunctions       ATMOSPHERE_TREATMENT = VENTILATE_OR_PURGE
///
/// That last one is the reason this table exists. The source says "ventilate OR
/// purge"; setting ventilation_required AND inert_gas_required on the template
/// would assert that BOTH are mandatory, which the source does not say. One
/// requirement row carries the disjunction intact.
///
/// requirement_type is deliberately String, not an enum: each new source
/// document brings its own vocabulary, and a migration per new rule type would
/// make adding a source harder than it needs to be.
model procedure_template_requirement {
  id                    Int @id @default(autoincrement())
  procedure_template_id Int

  requirement_type  String // ROB_LIMIT, PRECONDITION, ATMOSPHERE_TREATMENT, ...
  requirement_value String? // "0.05", "WD", "VENTILATE_OR_PURGE", "Cold Sea Water"
  operator          String? // comparison for measured limits: "<=", ">=", "="
  unit              String? // unit of requirement_value where it is a quantity

  mandatory     Boolean @default(true)
  description   String? @db.Text
  display_order Int // presentation order, 1-based

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  procedure_template procedure_templates @relation(fields: [procedure_template_id], references: [id], onDelete: Cascade)

  // Same slot-based idempotency as instructions: a re-import updates the row in
  // place. requirement_type is NOT the key - a source may legitimately state
  // two requirements of one type (two preconditions, say).
  //
  // Named explicitly: the generated name would exceed 63 characters, and Prisma
  // and PostgreSQL truncate it differently, which leaves the schema and the
  // database permanently disagreeing about the index name.
  @@unique([procedure_template_id, display_order], map: "procedure_template_requirement_display_order_key")
  @@index([procedure_template_id])
  @@index([requirement_type])
}

/// COMMON cargo-transition rule, shared by all three cargo types.
///
/// Answers "which procedure applies between these two cargoes?" - previous
/// cargo X, next cargo Y, run CW. procedure_templates answers the different
/// question of what CW means; the two must not be collapsed into one table.
///
/// POLYMORPHIC BY DESIGN. cargo_id / from_cargo_id / to_cargo_id hold an id
/// from ONE of three master tables, and cargo_type says which:
///
///     CHEMICAL -> cargo_chemical.id
///     OIL      -> crude_oil.id
///     GAS      -> gas.id
///
/// PostgreSQL cannot retarget a foreign key per row, so these columns carry NO
/// FK constraint and Prisma models NO relation for them. Referential integrity
/// is enforced instead by:
///   - the check constraints + validation trigger in the migration, and
///   - assertCargoRefs() in src/cargo-type.ts, on the write path.
/// Resolve the referent by branching on cargo_type - see resolveCargoRefs().
model cleaning_process {
  id         Int       @id @default(autoincrement())
  /// Discriminator for cargo_id / from_cargo_id / to_cargo_id. Every row that
  /// existed before this column (sources 7, 8, 9 - all chemical guides) is
  /// CHEMICAL, which is what the default backfills.
  cargo_type CargoType @default(CHEMICAL)

  cargo_id      Int? // single-cargo procedure, no transition (Miracle, source 9)
  from_cargo_id Int? // transition matrix: previous cargo
  to_cargo_id   Int? // transition matrix: next cargo

  // Family-grain matrix (Verwey PDF Book). That book keys its FROM->TO cells on
  // a family number, never on a member chemical, so those rows carry the family
  // pair instead of the cargo pair above. CHEMICAL-only: cargo_family_group
  // hangs off cargo_chemical, so these keep a real FK.
  from_cargo_family_group_id Int?
  to_cargo_family_group_id   Int?

  /// The procedure to run. Canonical link to procedure_templates; replaces the
  /// old (source_id, procedure_code) composite FK, which could not express a
  /// row whose template lives in another source.
  procedure_template_id Int?
  /// The code exactly as the source matrix prints it ("CW", "BF-VP", "A+").
  /// Redundant with procedure_template_id by design: it survives verbatim even
  /// when the legend page defines no matching template.
  procedure_code        String?

  source_id      Int
  cleaning_stage CleaningStage? // stage-based sources only (Miracle); NULL elsewhere
  method_number  Int? // stage-based sources only

  title      String?
  /// The qualifier printed in the matrix cell, verbatim - "If to-load is
  /// Chemical Grade", "Mogas Blend", "Colour <2.5 NPA", "otherwise NC".
  /// A cell with two conditions becomes two rows, one per condition; it is
  /// never flattened into a compatible/not-compatible boolean.
  condition  String?
  /// Free-text qualification that is not itself a selection condition
  /// (footnotes, operator warnings).
  remarks    String?
  recipe_for String?

  /// Page of the source document this rule was read from (Shell matrix = "3").
  source_page_ref String?
  notes           String?
  created_at      DateTime @default(now())
  updated_at      DateTime @default(now())

  from_family        cargo_family_group?     @relation("cp_from_family", fields: [from_cargo_family_group_id], references: [id], onDelete: Cascade)
  to_family          cargo_family_group?     @relation("cp_to_family", fields: [to_cargo_family_group_id], references: [id], onDelete: Cascade)
  source             source                  @relation(fields: [source_id], references: [id], onDelete: Cascade)
  procedure_template procedure_templates?    @relation(fields: [procedure_template_id], references: [id], onDelete: SetNull)
  steps              cleaning_process_step[]

  // Idempotency is enforced by partial UNIQUE indexes created in the migrations
  // (Prisma cannot express partial uniques). Three kinds of row, three keys:
  //   template rows    (procedure_code, source_id)  -- no cargo AND no family
  //   cargo-grain rows (from_cargo_id, to_cargo_id, source_id, condition)
  //   family-grain rows(source_id, from_cargo_family_group_id, to_cargo_family_group_id)
  // The cargo-grain key includes condition because one source cell can carry
  // several conditional outcomes for the same pair.
  @@unique([cargo_id, source_id, cleaning_stage, method_number])
  @@index([cargo_type])
  @@index([cargo_id])
  @@index([source_id])
  @@index([cargo_id, source_id])
  @@index([from_cargo_id])
  @@index([to_cargo_id])
  @@index([procedure_code])
  @@index([procedure_template_id])
  @@index([cargo_type, source_id])
  @@index([cargo_type, from_cargo_id])
  @@index([cargo_type, to_cargo_id])
}

// Ordered steps belonging to one cleaning_process (Butterworth -> Rinse -> Vent).
// Values are kept as text because source data is messy ("1,5-2,0", "warm",
// "20 Min", "Sea Water") rather than clean numerics.
model cleaning_process_step {
  id                  Int               @id @default(autoincrement())
  cleaning_process_id Int
  step_order          Int
  method              String?
  duration            String?
  temperature         String?
  medium              String?
  cleaner             String?
  description         String?
  remarks             String?
  mandatory           Boolean? // Verwey steps: every listed instruction is mandatory
  created_at          DateTime          @default(now())
  updated_at          DateTime          @default(now())
  step_type           CleaningStepType?
  cleaning_process    cleaning_process  @relation(fields: [cleaning_process_id], references: [id], onDelete: Cascade)

  @@unique([cleaning_process_id, step_order])
  @@index([cleaning_process_id])
}

// Coating recommendations, normalized out of cargo_chemical.permitted_coatings:
//   coating_company (HEMPEL) -> coating_system (15400) -> cargo_coating (rating)
model coating_company {
  id   Int    @id @default(autoincrement())
  name String @unique

  coatingSystems coating_system[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model coating_system {
  id          Int    @id @default(autoincrement())
  company_id  Int
  system_name String

  company coating_company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  cargoCoatings cargo_coating[]

  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@unique([company_id, system_name])
  @@index([company_id])
}

model cargo_coating {
  id                Int      @id @default(autoincrement())
  cargo_id          Int
  source_id         Int
  coating_system_id Int
  rating            String? // e.g. "Limited Resistance", "Recommended", "Not Suitable"
  notes             String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  cargo_chemical cargo_chemical @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  source         source         @relation(fields: [source_id], references: [id], onDelete: Cascade)
  coating_system coating_system @relation(fields: [coating_system_id], references: [id], onDelete: Cascade)

  @@index([cargo_id])
  @@index([source_id])
  @@index([coating_system_id])
  @@index([cargo_id, source_id])
}

model marine_chemicals {
  id                   Int      @id @unique @default(autoincrement())
  brand                String
  product_name         String
  product_type         String
  description          String?
  typical_application  String?
  ph_value             Int?
  compatible_materials String?
  typical_dose         String?
  hazards              String?
  supplier_msds_path   String?
  source_id            Int
  date_added           DateTime @default(now())
  notes                String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())

  source source @relation(fields: [source_id], references: [id], onDelete: Cascade)

  marineChemicalUses marine_chemical_use[]
}

model marine_chemical_use {
  id                                Int     @id @unique @default(autoincrement())
  marine_chemical_id                Int
  target_cargo_id                   Int?
  target_substance_category         String?
  recommended_procedure_template_id Int?

  marine_chemical    marine_chemicals     @relation(fields: [marine_chemical_id], references: [id], onDelete: Cascade)
  cargo_chemical     cargo_chemical?      @relation("target_cargo", fields: [target_cargo_id], references: [id], onDelete: SetNull)
  procedure_template procedure_templates? @relation(fields: [recommended_procedure_template_id], references: [id], onDelete: SetNull)
}

model changelog {
  id                     Int      @id @unique @default(autoincrement())
  entity_type            String
  entity_id              Int
  field_changed          String
  old_value              String?
  new_value              String?
  triggered_by_source_id Int?
  change_reason          String?
  changed_at             DateTime @default(now())
  created_at             DateTime @default(now())
  updated_at             DateTime @default(now())

  source source? @relation(fields: [triggered_by_source_id], references: [id], onDelete: SetNull)
}

model operational_requirement {
  id          Int     @id @default(autoincrement())
  code        String  @unique // 15.11.2
  section     String? // 15.11
  title       String
  description String?
  explanation String?

  source_id Int?
  source    source? @relation(fields: [source_id], references: [id])

  cargoRequirements cargo_operational_requirement[]
}

model cargo_operational_requirement {
  id Int @id @default(autoincrement())

  cargo_chemical_id          Int
  operational_requirement_id Int

  notes String?

  cargo_chemical cargo_chemical @relation(fields: [cargo_chemical_id], references: [id], onDelete: Cascade)

  operational_requirement operational_requirement @relation(fields: [operational_requirement_id], references: [id], onDelete: Cascade)

  @@unique([cargo_chemical_id, operational_requirement_id])
}

model cargo_hazard_data {
  id Int @id @default(autoincrement())

  cargo_id  Int
  source_id Int

  // Health
  health_hazard_rating     String?
  general_hazard           String? @db.Text
  symptoms                 String? @db.Text
  short_exposure_tolerance String? @db.Text
  exposure_procedure       String? @db.Text

  // Fire
  fire_grade             String?
  electrical_group       String?
  extinguishing_agents   String? @db.Text
  special_fire_procedure String? @db.Text

  // Reactivity
  stability                String?
  material_compatibility   String? @db.Text
  cargo_compatibility_note String? @db.Text

  // Spill
  spill_procedure String? @db.Text

  // DOT Hazardous Materials Table (49 CFR 172.101), Column (1) symbol(s).
  // Stored verbatim; may combine legend symbols (e.g. "A W"). See dot_hazmat_symbol
  // for the meaning of each single symbol.
  dot_symbol String?

  notes String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cargo_chemical cargo_chemical @relation(fields: [cargo_id], references: [id], onDelete: Cascade)
  source         source         @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([cargo_id, source_id])
  @@index([cargo_id])
  @@index([source_id])
}

// Legend for the DOT Hazardous Materials Table (49 CFR 172.101) Column (1).
// One row per single symbol; combinations that appear in the source (e.g. "A W")
// are unions of these and are stored verbatim in cargo_hazard_data.dot_symbol.
model dot_hazad_symbol {
  symbol      String @id // "+", "A", "D", "G", "I", "W"
  description String
}

// Verbatim import of the 49 CFR 172.101 Hazardous Materials Table. EVERY source
// row is preserved — normal materials, generic (n.o.s.) names, forbidden entries
// and "see ..." cross-references — WITHOUT creating cargo_chemical rows. cargo_id
// stays NULL until a row is linked to a canonical chemical (exact name match now,
// manual/synonym linking later); a set cargo_id is never clobbered on re-import.
model cargo_dot_hazad {
  id Int @id @default(autoincrement())

  cargo_id  Int? // NULL until linked to a canonical cargo_chemical
  source_id Int

  // Provenance + idempotency. row_hash = hash of all CFR columns for this row;
  // it is the dedup / upsert key (the HMT has no natural unique key — 435 shipping
  // names repeat). source_row is the 1-based ordinal in the source file (audit).
  row_hash String

  // Classification so every kind of row is preserved yet distinguishable.
  // 'material' | 'generic' (n.o.s.) | 'forbidden' | 'cross_reference'.
  entry_type    String
  see_reference String? // for cross-references: target name after ", see "

  symbol               String? // CFR Column (1): +, A, D, G, I, W, or a combo
  proper_shipping_name String // CFR (2)

  hazard_class          String? // (3)
  identification_number String? // (4) e.g. UN1090 / NA1993
  packing_group         String? // (5) I / II / III

  label_codes        String? // (6)
  special_provisions String? // (7)

  packaging_exception String? // (8A)
  packaging_non_bulk  String? // (8B)
  packaging_bulk      String? // (8C)

  passenger_quantity_limit String? // (9A)
  cargo_quantity_limit     String? // (9B)

  vessel_location String? // (10A)
  vessel_other    String? // (10B)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Linked chemical is optional; deleting the chemical only unlinks (keeps the
  // regulatory row). Source deletion cascades (the whole import goes with it).
  cargo_chemical cargo_chemical? @relation(fields: [cargo_id], references: [id], onDelete: SetNull)
  source         source          @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@unique([source_id, row_hash]) // idempotency key — see importer
  @@index([cargo_id])
  @@index([source_id])
  @@index([proper_shipping_name])
  @@index([identification_number])
  @@index([entry_type])
}

enum ReactiveGroupType {
  REACTIVE // groups 1–22
  CARGO // groups 30–43
}

enum CompatibilityExceptionType {
  Incompatible // matrix says incompatible, but the Appendix allows the pair
  Compatible // matrix says compatible, but the Appendix marks it incompatible
}

enum electrical_equipment_temperature_class {
  T1
  T2
  T3
  T4
  T5
  T6
}

enum electrical_equipment_apparatus_group {
  IIA
  IIB
  IIC
}

